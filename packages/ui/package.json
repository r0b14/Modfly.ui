{
  "name": "@modfly/ui",
  "version": "1.1.0",
  "description": "Components built for learning.",
  "keywords": [
    "react",
    "ui",
    "components",
    "e-learning",
    "tailwind"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tailwindcss -i src/styles.css -o dist/styles.css --minify && node ../../scripts/package-metadata.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5"
  },
  "devDependencies": {
    "@modfly/tsconfig": "workspace:*",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "esbuild-plugin-svgr": "^2.1.0",
    "typescript": "^5.4.0",
    "tailwindcss": "^3.4.19"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "homepage": "https://modfly.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r0b14/Modfly.ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  }
}
