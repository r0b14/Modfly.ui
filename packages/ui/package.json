    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "esbuild-plugin-svgr": "^2.1.0",
    "typescript": "^5.4.0"
