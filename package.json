{
  "name": "modfly-ui-monorepo",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "eslint packages/ui/src packages/ui-avamec/src packages/cli/src apps/docs scripts tests",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo typecheck",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm check && pnpm -r publish --access public",
    "docs:generate": "node scripts/generate-catalog.mjs",
    "test:packages": "node scripts/verify-packages.mjs"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@changesets/cli": "^2.29.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "vitest": "^3.2.0",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "^14.6.0",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "vite-plugin-svgr": "^4.3.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@emotion/css": "^11.13.5",
    "yaml": "^2.8.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.20.2",
      "@types/react-slick>@types/react": "^18.3.0"
    }
  }
}
